PORT=8080

# OPTION 1 (RECOMMENDED): Gmail SMTP with App Password
GMAIL_USER_EMAIL=nmnext.official@gmail.com
GMAIL_APP_PASSWORD=your_16_char_google_app_password

# OPTION 2: Resend API (starts with re_)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=onboarding@resend.dev
RESEND_REPLY_TO=nmnext.official@gmail.com

# OPTION 3: Google OAuth2
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
